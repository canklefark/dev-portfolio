---
import { getMenu } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead } from "emdash/ui";
import Nav from "../components/Nav.astro";
import { getSiteContext, ogUrl, type NavId } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  activeNav?: NavId;
  canonicalPath?: string;
  /** From pageMeta: the SEO panel canonical override (absolute or root-relative). */
  canonical?: string | null;
  /** From pageMeta: the share image (absolute or root-relative). */
  image?: string | null;
  /** From pageMeta: the robots directive when the SEO panel sets noindex. */
  robots?: string | null;
}

const { title, description, activeNav, canonicalPath, canonical, image, robots } = Astro.props;
const site = await getSiteContext();
const menu = await getMenu("primary");
if (!menu) throw new Error('The EmDash menu "primary" is missing; the nav is built from it');
const desc = description ?? site.tagline;
const ogHref = canonical
  ? new URL(canonical, Astro.site).href
  : ogUrl(canonicalPath ?? Astro.url.pathname, Astro.site);
const imageHref = image ? new URL(image, Astro.site).href : undefined;
// pageMeta has already applied the entry's SEO panel, so the resolved values go in explicitly and EmDashHead
// renders the description, canonical, robots, Open Graph, Twitter, JSON-LD, verification and favicon tags.
const page = createPublicPageContext({
  Astro,
  kind: "custom",
  pageType: "website",
  title,
  description: desc,
  canonical: ogHref,
  image: imageHref,
  seo: { robots },
  siteName: site.title,
  siteUrl: Astro.site?.origin,
});
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <EmDashHead page={page} />
    {!site.favicon && <link rel="icon" type="image/svg+xml" href="/favicon.svg" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexMono-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexMono-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("zk-theme"); } catch (_) {}
        if (!t) t = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <script is:inline>
      (function () {
        var amber = "color:#D4892B;font-family:monospace;font-size:13px;font-weight:700;letter-spacing:0.08em";
        var dim = "color:#777;font-family:monospace;font-size:11px";
        console.log("%cZEIK COOKSON", amber);
        console.log("%cDevOps Engineer · Knoxville, TN\nzeik.cookson@kellercreative.com", dim);
        console.log("%c→ Reading the source? Let's talk.", dim);
      })();
    </script>
    <script is:inline>
      (function () {
        var pending = false;
        var timer = null;
        var routes = { h: "/", p: "/projects", a: "/about" };
        document.addEventListener("keydown", function (e) {
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
          if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
          if (pending) {
            clearTimeout(timer);
            pending = false;
            var dest = routes[e.key];
            if (dest) { e.preventDefault(); window.location.href = dest; }
            return;
          }
          if (e.key === "g") {
            pending = true;
            timer = setTimeout(function () { pending = false; }, 800);
          }
        });
      })();
    </script>
  </head>
  <body>
    <div class="l-center page-col" style="--max: 800px">
      <a href="#main-content" class="skip-link">Skip to content</a>
      <Nav links={menu.items} activeNav={activeNav} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0;
    left: 50%;
    z-index: 10000;
    transform: translateX(-50%) translateY(-110%);
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border-hi);
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-md);
    font-weight: var(--fw-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--ease-standard);
  }
  .skip-link:focus-visible {
    transform: translateX(-50%) translateY(0.5rem);
  }
  .page-col {
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    min-height: 100svh;
    background: var(--bg);
    transition:
      border-color var(--ease-slow),
      background var(--ease-slow);
  }
  @media (max-width: 860px) {
    .page-col {
      border-left: none;
      border-right: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
