---
import Layout from "../../layouts/Layout.astro";
import LogEntry from "../../components/LogEntry.astro";
import BackButton from "../../components/BackButton.astro";
import { getSortedLogbook } from "../../lib/logbook";

const entries = await getSortedLogbook();
---

<Layout title="Logbook Archive — Zeik Cookson" description="All logbook entries. Working notes from the homelab and day job." activeNav="logbook">
  <section class="section">
    <div class="u-gutters">
      <BackButton href="/logbook" label="Back to Logbook" />
      <h1 class="section-label">All Entries</h1>
      {entries.length === 0
        ? <p class="empty-state">Nothing logged yet.</p>
        : entries.map((entry, i) => <LogEntry entry={entry} headingLevel={2} style={`--i: ${i}`} />)
      }
      <div class="u-spacer-l"></div>
    </div>
  </section>
</Layout>
