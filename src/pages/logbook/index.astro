---
import Layout from "../../layouts/Layout.astro";
import LogEntry from "../../components/LogEntry.astro";
import { getSortedLogbook } from "../../lib/logbook";

const allEntries = await getSortedLogbook();

const PAGE_SIZE = 10;
const entries = allEntries.slice(0, PAGE_SIZE);
const hasMore = allEntries.length > PAGE_SIZE;
---

<Layout title="Logbook — Zeik Cookson" description="Working notes from the homelab and day job. Practical DevOps write-ups." activeNav="logbook">
  <section class="section" data-page-entry>
    <div class="u-gutters">
      <h1 class="section-label">Logbook</h1>
      <p class="logbook-intro">
        Working notes from the homelab and the day job.
      </p>
      {entries.length === 0
        ? <p class="empty-state">Nothing logged yet.</p>
        : entries.map((entry, i) => <LogEntry entry={entry} headingLevel={2} style={`--i: ${i}`} />)
      }
      {hasMore && (
        <div class="logbook-footer u-text-right">
          <a href="/logbook/archive" class="cta-outline u-text-mono-xs">
            All {allEntries.length} entries →
          </a>
        </div>
      )}
      <div class="u-spacer-l"></div>
    </div>
  </section>
</Layout>

<style>
  .logbook-intro {
    font-size: var(--text-body-sm);
    color: var(--text-muted);
    margin-block-end: var(--s2);
    max-inline-size: var(--measure);
  }
</style>
