---
import { PortableText } from "emdash/ui";
import Layout from "../../layouts/Layout.astro";
import Chip from "../../components/Chip.astro";
import BackButton from "../../components/BackButton.astro";
import Cluster from "../../components/layout/Cluster.astro";
import Grid from "../../components/layout/Grid.astro";
import ProseBlock from "../../components/prose/ProseBlock.astro";
import ProseLink from "../../components/prose/ProseLink.astro";
import { getProject } from "../../lib/projects";
import { prepareBody } from "../../lib/prose";
import { getSiteContext, pageMeta } from "../../lib/site";

const slug = Astro.params.slug;
const detail = slug ? await getProject(slug) : null;
if (!detail) return new Response(null, { status: 404 });
const project = detail.data;
const site = await getSiteContext();
const meta = pageMeta(detail.source, site, { withSiteTitle: true, defaultDescription: project.summary });
---

<Layout title={meta.title} description={meta.description} activeNav="projects">
  <section class="section">
    <div class="u-gutters">
      <BackButton href="/projects" label="Back to Projects" />
      <div class="detail-stage">{project.category}</div>
      <h1 class="detail-h1">{project.title}</h1>
      <Cluster space="s-2" class="detail-chips">
        <Chip variant={project.statusVariant}>{project.status}</Chip>
        <Chip>SURFACE: {project.surface}</Chip>
      </Cluster>
      <p class="detail-sub">{project.sub}</p>
      <Grid min="9rem" class="detail-stats" data-divider>
        {
          project.stats.map((stat) => (
            <div class="detail-stat">
              <div class="data-cell-lbl detail-stat-lbl">{stat.label}</div>
              <div
                class="data-cell-val detail-stat-val u-color-variant"
                data-variant={stat.variant !== "default" ? stat.variant : undefined}
              >
                {stat.value}
              </div>
            </div>
          ))
        }
      </Grid>
      <div class="prose">
        <PortableText
          value={prepareBody(detail.body)}
          components={{ block: ProseBlock, mark: { link: ProseLink } }}
        />
      </div>
    </div>
  </section>
</Layout>
