---
import { getCollectionInfo } from "emdash";
import Layout from "../../layouts/Layout.astro";
import StageCard from "../../components/StageCard.astro";
import { getSortedProjects } from "../../lib/projects";
import { getSiteContext, pageMeta } from "../../lib/site";

const [projects, info, site] = await Promise.all([getSortedProjects(), getCollectionInfo("projects"), getSiteContext()]);
if (!info) throw new Error('The EmDash collection "projects" is missing');
// The listing page has no entry of its own: its title and description are the collection's label and description.
const meta = pageMeta({ data: { title: info.label, excerpt: info.description } }, site, { withSiteTitle: true });
---

<Layout title={meta.title} description={meta.description} canonical={meta.canonical} image={meta.image} robots={meta.robots} activeNav="projects">
  <section class="section" data-page-entry>
    <div class="u-gutters">
      <h1 class="section-label">All Projects</h1>
      {projects.length === 0
        ? <p class="empty-state">No stages documented yet.</p>
        : projects.map((entry, i) => <StageCard entry={entry} headingLevel={2} style={`--i: ${i}`} />)
      }
      <div class="u-spacer-l"></div>
    </div>
  </section>
</Layout>
