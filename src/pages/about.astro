---
import Layout from "../layouts/Layout.astro";
import AboutContent from "../data/about.md";
import { cells, stack, contacts, role } from "../data/about";
---

<Layout title="About — Zeik Cookson" activeNav="about">
  <section class="section">
    <div class="about-inner">
      <h2 class="about-h2">
        Designer who ended up<br />in the <em>engine bay.</em>
      </h2>
      <div class="about-role">{role}</div>

      <div class="about-body">
        <AboutContent />
      </div>

      <div class="l-switcher about-grid-2" style="--threshold: 30rem; --space: 1px" role="list">
        {
          cells.map((cell) => (
            <div class="about-cell" role="listitem">
              <div class="about-cell-lbl">{cell.label}</div>
              <div
                class="about-cell-val"
                data-variant={cell.variant ?? undefined}
              >
                {cell.value}
              </div>
            </div>
          ))
        }
      </div>

      <div class="stack-table">
        <div class="stack-thead">
          <span>Tool / Platform</span>
          <span>Status</span>
        </div>
        {
          stack.map((item) => (
            <div class="stack-row">
              <span class="stack-name">{item.name}</span>
              <span class="stack-level" data-level={item.level.toLowerCase()}>{item.level}</span>
            </div>
          ))
        }
      </div>

      <div class="contact-block">
        <p class="contact-lead">If the work here is interesting, reach out.</p>
        {
          contacts.map((contact) => (
            <a
              class="contact-item"
              href={contact.href}
              target={contact.icon !== "email" ? "_blank" : undefined}
              rel={contact.icon !== "email" ? "noopener" : undefined}
            >
              {contact.icon === "email" && (
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              )}
              {contact.icon === "github" && (
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                </svg>
              )}
              {contact.icon === "linkedin" && (
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              )}
              {contact.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
