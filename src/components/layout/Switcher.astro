---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  threshold?: string;
  space?: string;
}

const { threshold = "30rem", space = "s1", class: className, ...rest } = Astro.props;
---

<div
  class:list={["l-switcher", className]}
  style={`--threshold: ${threshold}; --space: var(--${space})`}
  {...rest}
>
  <slot />
</div>
