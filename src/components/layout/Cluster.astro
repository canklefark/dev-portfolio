---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  space?: string;
  justify?: string;
  align?: string;
}

const { space = "s0", justify = "flex-start", align = "center", class: className, ...rest } = Astro.props;
---

<div
  class:list={["l-cluster", className]}
  style={`--space: var(--${space}); --justify: ${justify}; --align: ${align}`}
  {...rest}
>
  <slot />
</div>
