---
import type { CollectionEntry } from "astro:content";
import Chip from "./Chip.astro";
import type { HeadingLevel } from "../lib/types";

interface Props {
  entry: CollectionEntry<"projects">;
  headingLevel?: HeadingLevel;
  style?: string;
}

const { entry, headingLevel = 3, style } = Astro.props;
const { data } = entry;
---

<a href={`/projects/${entry.id}`} class="stage-card u-entry-in" style={style}>
  <div class="l-stack" style="--space: var(--s1)">
    <div class="l-cluster stage-header" style="--justify: space-between; --align: center">
      {headingLevel === 2
        ? <h2 class="stage-title">{data.title}</h2>
        : <h3 class="stage-title">{data.title}</h3>
      }
      <div class="l-cluster stage-chips" style="--space: var(--s-2); --align: center">
        <Chip variant={data.statusVariant}>
          {data.status}
        </Chip>
      </div>
    </div>
    <div class="stage-desc">{data.summary}</div>
    <div class="l-cluster stage-tags" style="--space: var(--s-2)">
      {data.tags.map((tag) => <span class="stage-tag">{tag}</span>)}
    </div>
    <div class="l-cluster stage-footer" style="--justify: space-between">
      <span class="stage-time">
        SURFACE: {data.surface}&emsp;/&emsp;TIME: {data.timeLabel}&emsp;/&emsp;{data.period}
      </span>
      <span class="stage-read" aria-hidden="true">READ NOTES →</span>
    </div>
  </div>
</a>

<style>
  .stage-card {
    --entry-stagger: 0.07s;
    border: 1px solid var(--border);
    background: var(--bg-warm);
    padding: var(--s2);
    margin-bottom: 1px;
    cursor: pointer;
    transition:
      border-color var(--ease-standard),
      background var(--ease-standard),
      transform var(--ease-standard) var(--easing-out),
      box-shadow var(--ease-standard) var(--easing-out);
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .stage-card::before,
  .stage-card::after {
    content: "";
    position: absolute;
    width: 13px;
    height: 13px;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    transition:
      opacity var(--ease-press) var(--easing-out),
      transform var(--ease-standard) var(--easing-out);
  }
  .stage-card::before {
    top: 9px;
    left: 9px;
    border-top: 1.5px solid var(--accent);
    border-left: 1.5px solid var(--accent);
    transform: scale(0.3);
    transform-origin: top left;
  }
  .stage-card::after {
    bottom: 9px;
    right: 9px;
    border-bottom: 1.5px solid var(--accent);
    border-right: 1.5px solid var(--accent);
    transform: scale(0.3);
    transform-origin: bottom right;
  }
  .stage-card > .l-stack {
    position: relative;
    z-index: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .stage-card:hover {
      border-color: var(--border-hi);
      transform: translateY(-2px);
      box-shadow: var(--shadow-card-hover);
    }
    .stage-card:hover::before,
    .stage-card:hover::after {
      opacity: 1;
      transform: scale(1);
    }
  }
  .stage-header {
    gap: var(--s1);
  }
  .stage-title {
    font-family: var(--font-display);
    font-size: var(--text-display-md);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--text);
    display: inline;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--ease-emphasis) var(--easing-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .stage-card:hover .stage-title {
      background-size: 100% 1px;
    }
  }
  .stage-desc {
    font-size: var(--text-body-sm);
    color: var(--text-muted);
    line-height: 1.65;
  }
  .stage-tag {
    font-family: var(--font-mono);
    font-size: var(--text-mono-xs);
    font-weight: var(--fw-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.1rem 0.375rem;
  }
  .stage-footer {
    padding-block-start: 0.875rem;
    border-top: 1px solid var(--border);
  }
  .stage-time {
    font-family: var(--font-mono);
    font-size: var(--text-mono-md);
    color: var(--text-dim);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
  .stage-read {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity var(--ease-standard),
      transform var(--ease-standard) var(--easing-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .stage-card:hover .stage-read {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @media (max-width: 480px) {
    .stage-card {
      padding: var(--s1);
    }
    .stage-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
    }
  }
  @media (hover: none) {
    .stage-read {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-card:hover {
      transform: none;
      box-shadow: none;
    }
    .stage-card::before,
    .stage-card::after {
      transition: none;
    }
  }
</style>
