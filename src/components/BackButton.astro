---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---
<a href={href} class="back-btn">
  <svg
    width="10"
    height="10"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="15 18 9 12 15 6"></polyline>
  </svg>
  {label}
</a>
