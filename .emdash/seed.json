          "label": "Period",
          "type": "string",
          "required": true
        },
        {
          "slug": "summary",
          "label": "Summary",
          "type": "text",
          "required": true
        },
        {
          "slug": "sub",
          "label": "Sub",
          "type": "text",
          "required": true
        },
        {
          "slug": "stats",
          "label": "Stats",
          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "label",
                "type": "string",
                "label": "Label",
                "required": true
              },
              {
                "slug": "value",
                "type": "string",
                "label": "Value",
                "required": true
              },
              {
                "slug": "variant",
                "type": "select",
                "label": "Variant",
                "required": true,
                "options": [
                  "default",
                  "green",
                  "accent"
                ]
              }
            ]
          }
        },
        {
          "slug": "body",
          "label": "Body",
          "type": "portableText",
          "searchable": true
        }
      ]
    },
