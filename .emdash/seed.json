        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "date",
          "label": "Date",
          "type": "datetime",
          "required": true,
          "indexed": true
        },
        {
          "slug": "project_status",
          "label": "Status",
          "type": "string",
          "required": true
        },
        {
          "slug": "status_variant",
          "label": "Status variant",
          "type": "select",
          "required": true,
          "defaultValue": "default",
          "validation": {
            "options": [
              "accent",
              "green",
              "default"
            ]
          }
        },
        {
          "slug": "surface",
          "label": "Surface",
          "type": "string",
          "required": true
        },
        {
          "slug": "time_label",
          "label": "Time label",
          "type": "string",
          "required": true
        },
        {
